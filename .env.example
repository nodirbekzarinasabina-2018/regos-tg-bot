APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Asia/Tashkent
APP_BRAND_NAME=Chust optom No 1

REGOS_BASE_URL=https://integration.regos.uz/gateway/out
REGOS_INTEGRATION_KEY=YOUR_INTEGRATION_KEY
REGOS_CONNECTED_INTEGRATION_ID=YOUR_CONNECTED_INTEGRATION_ID
REGOS_TIMEOUT_SECONDS=20

# Agar REGOS sizga OAuth talab qilsa true qiling.
REGOS_USE_OAUTH=false
REGOS_TOKEN_URL=https://auth.regos.uz/oauth/token
REGOS_CLIENT_ID=
REGOS_CLIENT_SECRET=
REGOS_OAUTH_SCOPE=

TELEGRAM_BOT_TOKEN=123456:ABCDEF
TELEGRAM_GROUP_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=very_secret_path_token

# Agar botlarni ajratmoqchi bo'lsangiz, pastdagilarni to'ldiring.
# Bo'sh qolsa, eski TELEGRAM_* qiymatlari shared bot sifatida ishlayveradi.
WHOLESALE_BOT_TOKEN=123456:ABCDEF
WHOLESALE_GROUP_CHAT_ID=-1001234567890
WHOLESALE_WEBHOOK_SECRET=wholesale_secret
WHOLESALE_ADMIN_PHONE=+998770575732
WHOLESALE_PAYMENT_GROUP_ENABLED=false

RETAIL_BOT_TOKEN=123456:ABCDEF
RETAIL_GROUP_CHAT_ID=-1001234567890
RETAIL_WEBHOOK_SECRET=retail_secret

WAREHOUSE_BOT_TOKEN=123456:ABCDEF
WAREHOUSE_GROUP_CHAT_ID=-1001234567890
WAREHOUSE_WEBHOOK_SECRET=warehouse_secret

REMINDER_BOT_TOKEN=123456:ABCDEF
REMINDER_GROUP_CHAT_ID=-1001234567890
REMINDER_WEBHOOK_SECRET=reminder_secret

STORAGE_PATH=./data/bot.db
TEMP_DIR=./data/tmp
